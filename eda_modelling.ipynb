   "source": [
    "### Feature 2: Card count from `ip_address` in 7 days"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "7b6937b5",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_copy = df_copy.sort_values('transaction_date').reset_index(drop=True)\n",
    "\n",
    "df_copy = df_copy.set_index('transaction_date')\n",
    "\n",
    "rolling_out = ( df_copy.groupby('ip_address')['card_bin']\n",
    "               .rolling('7d')\n",
    "               .apply(lambda x: len(np.unique(x)), raw=True)\n",
    ") \n",
    "\n",
    "df_copy['total_cards_ip_7d'] = rolling_out.values\n",
    "\n",
    "\n",
    "df_copy = df_copy.reset_index()"
   ]
