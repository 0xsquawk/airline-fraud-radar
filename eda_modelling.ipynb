   "source": [
    "### Feature 4: Categorizing risk score as per `Email Domain usage`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "10604ad8",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_copy['email_domain'] = df_copy['email_address'].str.split('@').str[1]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "a54354f1",
   "metadata": {},
   "outputs": [],
   "source": [
    "domain_counts = df_copy['email_domain'].value_counts()\n",
    "\n",
    "df_copy['domain_txn_vol'] = df_copy['email_domain'].map(domain_counts)\n",
    "\n",
    "conditions = [df_copy['domain_txn_vol'] > 60000, (df_copy['domain_txn_vol'] >= 40000) & (df_copy['domain_txn_vol'] <= 55000)]\n",
    "\n",
    "choices = [0,1]\n",
    "df_copy['domain_risk_score'] = np.select(conditions, choices,default=2)\n",
    "\n",
    "df_copy = df_copy.drop(columns=['domain_txn_vol'])\n"
   ]
  },
